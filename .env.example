NODE_ENV=development
PORT=5000

# Base de données MongoDB
MONGODB_URI=mongodb://localhost:27017/rapidofiche

# Sécurité JWT (Authentification)
JWT_SECRET=votre_secret_jwt_access_min_16_caracteres
JWT_REFRESH_SECRET=votre_secret_jwt_refresh_min_16_caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Origines Frontend autorisées (CORS)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Stockage de fichiers (Cloudinary / Local)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# Passerelle de paiement GeniusPay
PAYMENT_PROVIDER=mock
GENIUSPAY_API_KEY=votre_api_key_geniuspay
GENIUSPAY_API_SECRET=votre_api_secret_geniuspay
GENIUSPAY_WEBHOOK_SECRET=votre_webhook_secret_geniuspay
GENIUSPAY_BASE_URL=https://pay.genius.ci/api/v1/merchant

# Google OAuth
GOOGLE_CLIENT_ID=votre_google_client_id.apps.googleusercontent.com
